GEMINI_API_KEY=your_api_key_here
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# CORS: one origin, or several comma-separated (no trailing slash needed), e.g.
# FRONTEND_URL=https://your-app.vercel.app,http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Signs the login tokens (JWT). Any long random string; generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
# Phase 6 (background jobs): a free Upstash Redis database (upstash.com, no
# card). Use the rediss:// URL (two s's = TLS). Eviction must be OFF for it.
REDIS_URL=rediss://default:password@your-db.upstash.io:6379
# Keeps local and production jobs apart in the one shared Redis:
# docmind-dev on your laptop, docmind on Render.
BULLMQ_PREFIX=docmind-dev
# Optional. false = don't start the queue worker with `npm run dev` (an idle
# worker still uses Upstash's monthly command budget). Default: on.
# RUN_WORKER=false
